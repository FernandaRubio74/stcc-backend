# Copiar a .env y completar los valores. El .env nunca se commitea.
# Todas las claves de este archivo son las que lee src/config/env.js;
# tests/unit/env-example.test.js falla si falta alguna.

# --- Servidor ---
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Base de datos ---
# Para ejecucion local contra el Postgres del docker-compose (publicado en 5433).
# Dentro de docker compose el compose sobreescribe esta variable y usa db:5432.
DATABASE_URL="postgresql://ideator:ideator@localhost:5433/ideator_db?schema=public"

# --- Autenticacion ---
JWT_EXPIRES_IN=1d
# Par RSA para el cifrado hibrido del token de sesion (ver auth/jwe.service.js).
# Generar con: node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log(privateKey.trim().replace(/\n/g,'\\n'));console.log(publicKey.trim().replace(/\n/g,'\\n'));"
JWT_RSA_PRIVATE_KEY=
JWT_RSA_PUBLIC_KEY=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=http://localhost:3000/auth/sso/callback

# --- IA ---
# Orden de preferencia (ver selectModel en src/modules/ai/adk/runAgentTurn.js):
# 1) Vertex AI (GCP) si hay GOOGLE_CLOUD_PROJECT
# 2) Gemini por API key simple (Google AI Studio) si hay GEMINI_API_KEY
# 3) Azure AI Foundry, como respaldo

# gemini-3.8-flash tiene cuota gratuita de solo 20 req/dia en Google AI
# Studio (confirmado en vivo: 429 "Quota exceeded... retry in 5h40m").
# gemini-3.5-flash-lite no tuvo ese problema en pruebas reales.
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcion 1: Vertex AI. La autenticacion NO es una variable de este archivo:
# es Application Default Credentials, normalmente un service account.
# Pasos en GCP: habilitar la API de Vertex AI, crear un service account con
# el rol "Vertex AI User", descargar su JSON de credenciales, y apuntar
# GOOGLE_APPLICATION_CREDENTIALS a la ruta de ese archivo en disco.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# Opcion 2: Gemini por API key simple (alternativa mas rapida a Vertex,
# sin GCP de por medio). Conseguir una en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcion 3: Azure AI Foundry / Azure OpenAI (superficie compatible con
# OpenAI v1), queda como respaldo si no hay credenciales de Google.
AI_PROVIDER_API_KEY=
AI_ENDPOINT=
AI_DEPLOYMENT=
# Presupuesto de tokens y timeout por llamada (solo aplica al camino de
# Azure). Los valores por defecto del codigo (16384 tokens / 90s) salieron de
# pruebas reales: gpt-5 puede gastar todo el presupuesto en razonamiento
# oculto y dejar la respuesta vacia.
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=1
