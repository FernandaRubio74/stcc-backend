# Copiar a .env y completar los valores. El .env nunca se commitea.
# Todas las claves de este archivo son las que lee src/config/env.js;
# tests/unit/env-example.test.js falla si falta alguna.

# --- Servidor ---
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Base de datos ---
# Para ejecucion local contra el Postgres del docker-compose (publicado en 5433).
# Dentro de docker compose el compose sobreescribe esta variable y usa db:5432.
DATABASE_URL="postgresql://ideator:ideator@localhost:5433/ideator_db?schema=public"

# --- Autenticacion ---
JWT_SECRET=
JWT_EXPIRES_IN=1d
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CALLBACK_URL=http://localhost:3000/auth/sso/callback

# --- IA (Azure AI Foundry / Azure OpenAI, superficie compatible con OpenAI v1) ---
AI_PROVIDER_API_KEY=
AI_ENDPOINT=
AI_DEPLOYMENT=
# Presupuesto de tokens y timeout por llamada. Los valores por defecto del
# codigo (16384 tokens / 90s) salieron de pruebas reales: gpt-5 puede gastar
# todo el presupuesto en razonamiento oculto y dejar la respuesta vacia.
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=1
