{
  "name": "stcc-backend",
  "version": "0.1.0",
  "description": "API y logica de negocio de Ideator",
  "private": true,
  "scripts": {
    "dev": "node src/server.js",
    "build": "echo \"No build step needed (plain Node.js)\"",
    "start": "node src/server.js",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts}\" --fix",
    "format": "prettier --write .",
    "seed": "echo \"[pendiente] sin datos de negocio definidos aun\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "prisma migrate deploy --schema=src/database/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema=src/database/schema.prisma",
    "generate": "prisma generate --schema=src/database/schema.prisma",
    "studio": "prisma studio --schema=src/database/schema.prisma",
    "setup": "npm run db:up && npm run migrate && npm run generate",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.11.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "prisma": "^5.20.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000
  }
}