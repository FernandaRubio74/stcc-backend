// ============================================================
// Ideator - Modelo de datos inicial
// US: Como equipo de backend, quiero un modelo de datos inicial
// para usuarios, proyectos y membresias...
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Nota: este schema vive en src/database/schema.prisma (no en ./prisma/,
// que es la ubicacion por defecto de Prisma) para respetar la estructura
// de carpetas ya definida en el repo. Por eso todos los comandos de Prisma
// en package.json usan la flag --schema=src/database/schema.prisma.

enum ProjectRole {
  owner
  editor
  viewer
}

// Etapas del wizard conversacional (EPIC-05). Se van agregando a medida que
// se implementan los sprints siguientes (modelo de datos, spec de API, etc.).
enum DefinitionStage {
  PROBLEM_CONTEXT
  TARGET_USERS_SCOPE
}

enum DefinitionMessageRole {
  user
  assistant
}

// EPIC-05, US-021: una version es DRAFT mientras se edita colaborativamente
// y pasa a APPROVED (inmutable) cuando el owner la aprueba. Nunca se
// sobreescribe una version aprobada: una edicion posterior crea una nueva
// version DRAFT.
enum DataModelVersionStatus {
  DRAFT
  APPROVED
}

// EPIC-06, US-024: mismo ciclo de vida que DataModelVersionStatus (DRAFT
// editable, APPROVED inmutable) aplicado a la especificacion de API.
enum ApiSpecVersionStatus {
  DRAFT
  APPROVED
}

// ------------------------------------------------------------
// User
// ------------------------------------------------------------
model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique @db.VarChar(255)
  passwordHash String? @map("password_hash") @db.VarChar(255)
  fullName     String  @map("full_name") @db.VarChar(150)

  // Campos mínimos para soportar SSO desde el diseño (login local o proveedor externo)
  authProvider String  @default("local") @map("auth_provider") @db.VarChar(30)
  providerId   String? @map("provider_id") @db.VarChar(255)

  // --- Auditoría ---
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Auto-referencia: quién creó este usuario (null = se registró solo)
  createdById  String? @map("created_by") @db.Uuid
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdUsers User[]  @relation("UserCreatedBy")

  // --- Relaciones inversas ---
  ownedProjects         Project[]           @relation("ProjectCreatedBy")
  memberships           ProjectMember[]     @relation("MemberUser")
  addedMemberships      ProjectMember[]     @relation("MemberCreatedBy")
  definitionMessages    DefinitionMessage[] @relation("DefinitionMessageAuthor")
  authoredModelVersions DataModelVersion[]  @relation("DataModelVersionAuthor")
  approvedModelVersions DataModelVersion[]  @relation("DataModelVersionApprover")
  authoredApiSpecVersions ApiSpecVersion[]  @relation("ApiSpecVersionAuthor")
  approvedApiSpecVersions ApiSpecVersion[]  @relation("ApiSpecVersionApprover")
  authoredScreenMaps      ScreenMap[]       @relation("ScreenMapAuthor")
  selectedArchitectures   ProjectArchitecture[] @relation("ProjectArchitectureSelector")

  // Evita que dos usuarios locales/SSO compartan la misma identidad externa
  @@unique([authProvider, providerId], map: "uq_user_provider")
  @@map("users")
}

// ------------------------------------------------------------
// Project
// ------------------------------------------------------------
model Project {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(150)
  description String?
  isPrivate   Boolean @default(true) @map("is_private")

  // --- Auditoría ---
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  members ProjectMember[]

  definition         ProjectDefinition?
  definitionMessages DefinitionMessage[]
  blockingQuestions  BlockingQuestion[]
  dataModelVersions  DataModelVersion[]
  apiSpecVersions    ApiSpecVersion[]
  screenMap          ScreenMap?
  architecture       ProjectArchitecture?

  @@map("projects")
}

// ------------------------------------------------------------
// ProjectMember (resuelve la relación N:M entre User y Project)
// ------------------------------------------------------------
model ProjectMember {
  id String @id @default(uuid()) @db.Uuid

  userId    String      @map("user_id") @db.Uuid
  user      User        @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  projectId String      @map("project_id") @db.Uuid
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role      ProjectRole @default(viewer)

  // --- Auditoría ---
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation("MemberCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Un usuario no puede tener más de una membresía activa por proyecto
  @@unique([userId, projectId], map: "uq_project_member")
  @@map("project_members")
}

// ------------------------------------------------------------
// ProjectDefinition (EPIC-05, US-015/US-016) — estado estructurado del
// wizard conversacional. Cardinalidad 1:1 con Project: cada proyecto tiene
// a lo sumo una definicion, creada de forma perezosa en el primer mensaje.
// ------------------------------------------------------------
model ProjectDefinition {
  projectId    String          @id @map("project_id") @db.Uuid
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  currentStage DefinitionStage @default(PROBLEM_CONTEXT) @map("current_stage")

  // US-015: sintesis del problema/contexto, mantenida por la IA turno a turno.
  problemSummary String? @map("problem_summary")

  // US-016: estructurados; el modelo reescribe el valor completo en cada
  // turno (no hace merge de deltas) para evitar inconsistencias acumuladas.
  targetUsers Json? @map("target_users")
  mvpScope    Json? @map("mvp_scope")
  userJourney Json? @map("user_journey")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("project_definitions")
}

// ------------------------------------------------------------
// DefinitionMessage (US-015.3) — historial de conversacion del wizard.
// ------------------------------------------------------------
model DefinitionMessage {
  id        String                @id @default(uuid()) @db.Uuid
  projectId String                @map("project_id") @db.Uuid
  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stage     DefinitionStage
  role      DefinitionMessageRole
  content   String

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdById String?  @map("created_by") @db.Uuid
  createdBy   User?    @relation("DefinitionMessageAuthor", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Los mensajes del asistente no tienen autor humano.
  @@index([projectId, createdAt])
  @@map("definition_messages")
}

// ------------------------------------------------------------
// BlockingQuestion (US-017) — preguntas que impiden avanzar de etapa
// mientras no esten resueltas.
// ------------------------------------------------------------
model BlockingQuestion {
  id        String          @id @default(uuid()) @db.Uuid
  projectId String          @map("project_id") @db.Uuid
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stage     DefinitionStage
  question  String

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz

  @@index([projectId, stage, resolvedAt])
  @@map("blocking_questions")
}

// ------------------------------------------------------------
// DataModelVersion (US-019/US-020/US-021) — entidades propuestas (por la
// IA o editadas a mano) para el modelo fisico de base de datos. `entities`
// y el diagrama Mermaid derivado se guardan como snapshot completo por
// version: una vez APPROVED, la fila es inmutable (ver enum) y cualquier
// edicion posterior crea una version DRAFT nueva.
// ------------------------------------------------------------
model DataModelVersion {
  id            String                 @id @default(uuid()) @db.Uuid
  projectId     String                 @map("project_id") @db.Uuid
  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  versionNumber Int                    @map("version_number")
  status        DataModelVersionStatus @default(DRAFT)
  entities      Json
  diagram       String?

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdById String?  @map("created_by") @db.Uuid
  createdBy   User?    @relation("DataModelVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  approvedAt   DateTime? @map("approved_at") @db.Timestamptz
  approvedById String?   @map("approved_by") @db.Uuid
  approvedBy   User?     @relation("DataModelVersionApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([projectId, versionNumber], map: "uq_data_model_version")
  @@index([projectId, status])
  @@map("data_model_versions")
}

// ------------------------------------------------------------
// ApiSpecVersion (US-023/US-024) — endpoints propuestos (por la IA o
// editados a mano) para la especificacion de la API. Mismo esquema de
// versionado que DataModelVersion: snapshot completo por version, DRAFT
// editable in-place, APPROVED inmutable.
// ------------------------------------------------------------
model ApiSpecVersion {
  id            String               @id @default(uuid()) @db.Uuid
  projectId     String               @map("project_id") @db.Uuid
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  versionNumber Int                  @map("version_number")
  status        ApiSpecVersionStatus @default(DRAFT)
  endpoints     Json

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdById String?  @map("created_by") @db.Uuid
  createdBy   User?    @relation("ApiSpecVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  approvedAt   DateTime? @map("approved_at") @db.Timestamptz
  approvedById String?   @map("approved_by") @db.Uuid
  approvedBy   User?     @relation("ApiSpecVersionApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([projectId, versionNumber], map: "uq_api_spec_version")
  @@index([projectId, status])
  @@map("api_spec_versions")
}

// ------------------------------------------------------------
// ScreenMap (US-027) — mapa de pantallas, navegacion y mockups de baja
// fidelidad. A diferencia de DataModelVersion/ApiSpecVersion, el DoD no
// pide versionado DRAFT/APPROVED para esta etapa: es una fila 1:1 por
// proyecto que se sobreescribe al regenerar (mismo patron que
// ProjectDefinition).
// ------------------------------------------------------------
model ScreenMap {
  projectId  String  @id @map("project_id") @db.Uuid
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  screens    Json
  navigation Json
  diagram    String

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdById String?  @map("created_by") @db.Uuid
  createdBy   User?    @relation("ScreenMapAuthor", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("screen_maps")
}

// ------------------------------------------------------------
// ProjectArchitecture (US-028) — recomendacion de la IA (de un catalogo
// fijo en codigo, ver architecture/catalog.js) y la seleccion final del
// usuario (que puede coincidir con la recomendacion o ser una eleccion
// explicita de otra opcion del catalogo). 1:1 por proyecto: no hay
// historial, la ultima recomendacion/seleccion es la vigente.
// ------------------------------------------------------------
model ProjectArchitecture {
  projectId     String    @id @map("project_id") @db.Uuid
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recommendedId String?   @map("recommended_id")
  justification String?
  selectedId    String?   @map("selected_id")
  selectedAt    DateTime? @map("selected_at") @db.Timestamptz

  selectedById String? @map("selected_by") @db.Uuid
  selectedBy   User?   @relation("ProjectArchitectureSelector", fields: [selectedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("project_architectures")
}
